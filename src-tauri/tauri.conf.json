{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxelPort Tauri Dev",
  "version": "2.0.0-beta.2",
  "identifier": "in.voxelport.app.dev",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxelPort (Tauri dev)",
        "width": 640,
        "height": 800,
        "minWidth": 540,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [], "requireSignedVersion": true }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
